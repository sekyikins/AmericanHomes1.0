# AmericanHomes Production Environment Template
# Copy to your secret manager or production environment (never commit real secrets).

NODE_ENV=production
PORT=3001

# Isolated Production PostgreSQL / Supabase
# Use pooled connection for DATABASE_URL and direct connection for Prisma migrations (DIRECT_URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Strong 32+ char random secret (e.g., `openssl rand -hex 32`)
JWT_SECRET="replace-with-at-least-32-character-random-production-secret"

# Exact HTTPS storefront / staff portal origins (comma-separated, never '*')
CORS_ORIGINS="https://americanhomes.gh,https://www.americanhomes.gh"

# Web Frontend API Base URL
NEXT_PUBLIC_API_BASE_URL="https://api.americanhomes.gh/api"

# Swagger Docs (keep false in production)
ENABLE_SWAGGER=false
AUTH_RATE_LIMIT_MAX=20

# External Integrations (Action 4 — configure when credentials are ready)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
OTP_PROVIDER_URL=""
OTP_API_KEY=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_WEBHOOK_SECRET=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""
STORAGE_BUCKET=""
